{
  "builds": {
    "browser": {
      "define": {
        "__ENVIRONMENT__": "\"production\"",
        "__PLATFORM__": "\"browser\""
      },
      "entryPoints": ["src/index.ts"],
      "mainFields": ["module", "browser", "main"],
      "outdir": "lib/browser",
      "platform": "browser",
      "target": ["chrome115", "firefox116", "edge115", "opera124", "safari16.4"]
    }
  },
  "declaration": {
    "declarationRollup": true,
    "documentation": true,
    "documentationHeading": "## API",
    "entryPoints": ["src/index.ts"],
    "tsconfig": "tsconfig-build.json"
  }
}
