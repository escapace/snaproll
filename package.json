{
  "name": "snaproll",
  "description": "Fixed‑timestep update loop with independent draw rate and quantized interpolation",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/snaproll/issues",
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@escapace/pnpm-pack": "0.6.1",
    "@ls-lint/ls-lint": "2.3.1",
    "@tweakpane/core": "2.0.5",
    "@vitejs/plugin-vue": "6.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vueuse/core": "13.9.0",
    "es-toolkit": "1.39.10",
    "eslint": "9.36.0",
    "eslint-config-escapace": "5.10.1",
    "esroll": "1.1.1",
    "jsdom": "27.4.0",
    "knip": "5.64.0",
    "lefthook": "1.13.4",
    "prettier": "3.6.2",
    "prettier-config-escapace": "1.2.1",
    "syncpack": "13.0.4",
    "tsx": "4.20.5",
    "tweakpane": "4.0.5",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "vue": "3.5.21",
    "vue-router": "4.5.1"
  },
  "engines": {
    "pnpm": "^10.10.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/browser/index.js"
    }
  },
  "files": [
    "lib/browser",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/snaproll#readme",
  "license": "MPL-2.0",
  "module": "./lib/browser/index.js",
  "peerDependencies": {
    "@escapace/with-promise": "^1.3.0",
    "coastal": "^0.2.1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/snaproll",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:github-pages": "vite build",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
