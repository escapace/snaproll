{
  "name": "snaproll",
  "description": "Fixed‑timestep update loop with independent draw rate and quantized interpolation",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/snaproll/issues",
  "devDependencies": {
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@escapace/pnpm-pack": "0.8.0",
    "@escapace/syncpack-configuration": "0.1.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@tweakpane/core": "2.0.5",
    "@vitejs/plugin-vue": "6.0.4",
    "@vitest/coverage-v8": "4.0.18",
    "@vueuse/core": "14.2.1",
    "es-toolkit": "1.45.0",
    "eslint": "9.39.3",
    "eslint-config-escapace": "5.14.0",
    "esroll": "1.1.5",
    "jsdom": "28.1.0",
    "knip": "5.85.0",
    "lefthook": "2.1.2",
    "prettier": "3.8.1",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "14.0.1",
    "tsx": "4.21.0",
    "tweakpane": "4.0.5",
    "typescript": "5.9.3",
    "vite": "8.0.3",
    "vitest": "4.0.18",
    "vue": "3.5.29",
    "vue-router": "5.0.3"
  },
  "engines": {
    "pnpm": ">=10.29.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/browser/index.js"
    }
  },
  "files": [
    "lib/browser",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/snaproll#readme",
  "license": "MPL-2.0",
  "module": "./lib/browser/index.js",
  "peerDependencies": {
    "@escapace/with-promise": "^1.3.1",
    "coastal": "^0.2.1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/snaproll",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:github-pages": "vite build",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
