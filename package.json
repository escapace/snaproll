{
  "name": "snaproll",
  "description": "Fixed‑timestep update loop with independent draw rate and quantized interpolation",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/snaproll/issues",
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@escapace/pnpm-pack": "0.9.1",
    "@escapace/syncpack-configuration": "0.3.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@tweakpane/core": "2.0.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vueuse/core": "14.4.0",
    "es-toolkit": "1.50.0",
    "eslint": "10.8.0",
    "eslint-config-escapace": "5.20.1",
    "esroll": "1.3.0",
    "jsdom": "30.0.1",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "15.3.2",
    "tsx": "4.23.1",
    "tweakpane": "4.0.5",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn",
      "version": "^11.7.0"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/browser/index.js"
    }
  },
  "files": [
    "lib/browser",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/snaproll#readme",
  "license": "MPL-2.0",
  "module": "./lib/browser/index.js",
  "peerDependencies": {
    "@escapace/with-promise": "^1.3.2",
    "coastal": "^0.4.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/snaproll",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:github-pages": "vite build",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
